# Database (required)
DATABASE_URL=postgresql://davin:localdev@localhost:5432/casadedavin

# Google Calendar API (OPTIONAL — calendar sync disabled if empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Resend (transactional email)
RESEND_API_KEY=re_
MAIL_FROM="Davin <me@casadedavin.house>"
MAIL_TO=davin@personal.example

# Auth
SESSION_SECRET=generate-a-random-32-char-string-here
SITE_PASSWORD=sincerely

# Google OIDC admin login (comma-separated emails allowed as admin)
GOOGLE_ADMIN_EMAILS=davin@example.com

# Public URL (used for OAuth redirect URI)
NEXT_PUBLIC_URL=http://localhost:3000
